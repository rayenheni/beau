# Connexion PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://utilisateur:motdepasse@127.0.0.1:5432/nom_de_la_base

# ---------------------------------------------------------------------------
# Sécurité de l'espace pro
# Mot de passe exigé pour accéder à /admin et aux routes de gestion.
# ⚠️  Obligatoire (min. 6 caractères). Générer une valeur longue et unique :
#     openssl rand -base64 32
# Si cette variable est absente, l'espace pro reste volontairement fermé.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=remplacer-par-un-secret-long-et-unique

# URL publique du site (sans slash final) — utilisée pour le SEO et le sitemap.
NEXT_PUBLIC_SITE_URL=https://www.exemple.tn
