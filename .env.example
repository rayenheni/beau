# ============================================================================
#  CONFIGURATION — un fichier par CLIENT (un déploiement = un salon)
#  Généré avec : npm run new-client
#  Guide complet : docs/ONBOARDING.md
# ============================================================================

# ---------------------------------------------------------------------------
# 1. BASE DE DONNÉES — compte Neon du CLIENT (gratuit au démarrage)
#    Neon → projet → Connection string, copier l'URL "pooled".
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxx.eu-central-1.aws.neon.tech/nom_de_la_base?sslmode=require

# ---------------------------------------------------------------------------
# 2. ESPACE PRO — mot de passe /admin (min. 6 caractères, unique par client)
#    Générer : openssl rand -base64 32
#    Sans cette variable, l'espace pro reste volontairement fermé (503).
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=remplacer-par-un-secret-long-et-unique

# ---------------------------------------------------------------------------
# 3. IDENTITÉ DU SALON — tout le site (textes, SEO, WhatsApp, exports) suit.
#    Valeurs par défaut = client pilote. Tout est modifiable sans toucher au code.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.exemple.tn
NEXT_PUBLIC_SALON_NAME=Salon Salwa de Coiffure & d'Esthétique
NEXT_PUBLIC_SALON_SHORT_NAME=Salwa
NEXT_PUBLIC_SALON_TAGLINE=Coiffure · Esthétique
NEXT_PUBLIC_SALON_CITY=Tunis
NEXT_PUBLIC_SALON_SLOGAN=Il est toujours temps de se faire plus belle.
NEXT_PUBLIC_SALON_DESCRIPTION=Salon de coiffure & d'esthétique au cœur du centre-ville de Tunis. Balayage, lissage kératine, chignons de mariée, maquillage, soins du visage, manucure.
NEXT_PUBLIC_SALON_PHONE=+21629311109
NEXT_PUBLIC_SALON_PHONE_DISPLAY=+216 29 311 109
NEXT_PUBLIC_SALON_WHATSAPP=21629311109
NEXT_PUBLIC_SALON_ADDRESS=Rue Houcine Bouzaiene, à côté du Théâtre de l'Étoile du Nord, Centre-Ville, Tunis
NEXT_PUBLIC_SALON_ADDRESS_SHORT=Centre-Ville, Tunis
NEXT_PUBLIC_SALON_REF_PREFIX=SW
NEXT_PUBLIC_SALON_DOMAIN=salonsalwa.tn
NEXT_PUBLIC_SALON_SLUG=salon-salwa
NEXT_PUBLIC_SALON_FACEBOOK=https://www.facebook.com/p/Salon-Salwa-de-Coiffure-dEsth%C3%A9tique-100063708455598/
NEXT_PUBLIC_SALON_FACEBOOK_REVIEWS=https://www.facebook.com/p/Salon-Salwa-de-Coiffure-dEsth%C3%A9tique-100063708455598/reviews
NEXT_PUBLIC_SALON_INSTAGRAM=https://www.instagram.com/salon.salwa/
NEXT_PUBLIC_SALON_INSTAGRAM_HANDLE=@salon.salwa
NEXT_PUBLIC_SALON_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Th%C3%A9%C3%A2tre+de+l%27%C3%89toile+du+Nord+Tunis
NEXT_PUBLIC_SALON_MAPS_EMBED=https://www.google.com/maps?q=Th%C3%A9%C3%A2tre%20de%20l'%C3%89toile%20du%20Nord%2C%20Tunis%2C%20Tunisie&z=16&output=embed
NEXT_PUBLIC_SALON_KEYWORDS=salon de coiffure tunis,coiffure esthétique tunis,balayage tunis,lissage kératine tunis,maquillage mariée tunis

# ---------------------------------------------------------------------------
# 4. E-MAIL (optionnel) — alertes de nouvelle réservation via Resend.
#    Sans ces 3 variables, le site reste pleinement fonctionnel
#    (cloche temps réel dans l'espace pro). Compte Resend du client.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxx
# MAIL_FROM=reservations@exemple.tn
# MAIL_TO=lesalon@exemple.tn
